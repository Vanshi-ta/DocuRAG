# Copy this file to .env and adjust as needed. .env is git-ignored.
# DocuRAG runs fully locally, so there are no API keys to set. Every tunable
# value below can be overridden here; the defaults shown match config.py.
# (Directory/file locations are fixed in config.py and are not env-driven.)

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Retrieval ---
DEFAULT_TOP_K=6
MAX_TOP_K=10
CANDIDATE_POOL_SIZE=15
MAX_CHUNKS_PER_SOURCE=2
ENTITY_FANOUT_ENABLED=true
SIMILARITY_THRESHOLD_ENABLED=false
SIMILARITY_THRESHOLD=0.3

# --- Generation (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=300

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
