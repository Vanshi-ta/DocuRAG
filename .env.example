# Copy this file to .env and adjust as needed. .env is git-ignored.
# DocuRAG runs fully locally, so there are no API keys to set — but every
# tunable knob is exposed here rather than hard-coded, so deployment-specific
# values never need a code change.

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Retrieval ---
DEFAULT_TOP_K=4
MAX_TOP_K=10
SIMILARITY_THRESHOLD_ENABLED=true
SIMILARITY_THRESHOLD=0.3

# --- Generation (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
