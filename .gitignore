# --- Secrets / environment ---
.env

# --- User data: never commit real uploaded documents or the index built from them ---
data/uploads/*
!data/uploads/.gitkeep
data/vector_store/*
!data/vector_store/.gitkeep

# --- Evaluation run outputs (regenerated by scripts/evaluate.py) ---
eval_results/

# --- Logs ---
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Model caches (downloaded on first run, can be gigabytes) ---
.cache/
**/sentence-transformers/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
